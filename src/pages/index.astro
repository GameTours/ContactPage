---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<Header />
	<body>
		<main>
			<h1>Contact</h1>
			<h2>
               Hello! Nice to meet you 
			</h2>
				<br>
			<p>
				I am online on Instagram, Facebook and with email.
			</p>
			<p>Follow me at <a href="https://instagram.com/young.jty" target="_blank" rel="noopener noreferrer">@young.jty</a> on Instagram</p>
			<p>I'm on Facebook at <a href="https://facebook.com/jtyoungme/" target="_blank" rel="noopener noreferrer">https://facebook.com/jtyoungme/</a></p>
				<br>
			<p>If you'd like to contact me with email. Send a message to <ObfuscatedEmail email="webmaster@jtyoung.me" /></p>

		</main>
	</body>
	<style>
		/* Override H2  element styles for this page only... */
		h2 {
			margin-top: 26px;
			margin-bottom: 26px;
			font-size: 28px;
		}

	</style>
</html>
 
