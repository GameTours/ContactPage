---
// PhotoGrid.astro
// Usage: wrap Image components (or <img>/<picture>) as children inside <PhotoGrid> in MDX.
// The grid enforces square cells, and images are centered and scaled to fit (no stretching).
const { children } = Astro.props;
---
<style>
  :root {
    --gap: 1rem;
    --radius: 8px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap);
    align-items: stretch;
  }

  @media (min-width: 1500px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 2000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Each child is a square container */
  .item {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1; /* keep square cells */
    overflow: hidden;
    border-radius: var(--radius);
    background-color: #f6f6f6; /* visible background when image doesn't fill */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Ensure <picture>/<img> content is centered and fits without stretching.
     We use max-width / max-height so the image keeps native aspect ratio. */
  .item :global(picture),
  .item :global(img) {
    /* allow the element to scale responsively but not exceed container */
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
    object-fit: contain;    /* preserve aspect ratio, don't crop */
    object-position: center;
  }

  /* Remove default margins if the wrapped component introduces them */
  .item :global(picture),
  .item :global(img) {
    margin: 0;
    padding: 0;
    border: 0;
  }
</style>

<div class="grid">
  {children.map((child) => (
    <div class="item">{child}</div>
  ))}
</div>
